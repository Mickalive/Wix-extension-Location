{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "wix-build-director",
  "subagent_depth": 1,
  "enabled_providers": ["opencode"],
  "share": "disabled",
  "autoupdate": false,
  "instructions": ["MAIN_PROMPT.md", "AGENTS.md", "docs/agent-workflow.md"],
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p8": "deny",
      "**/*.p12": "deny",
      "**/.npmrc": "deny",
      "**/credentials.json": "deny"
    },
    "edit": "deny",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run check*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "npx wix build*": "allow",
      "git push*": "deny",
      "git merge*": "deny",
      "gh pr merge*": "deny",
      "npm publish*": "deny",
      "npx wix release*": "deny",
      "wix release*": "deny",
      "rm -rf*": "deny"
    }
  }
}
